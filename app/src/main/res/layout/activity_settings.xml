<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:outlineSpotShadowColor="@color/white"
                app:icon="@drawable/arrow_back_icon"
                app:iconTint="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:fontFamily="@font/yandex_sans_text_medium"
                android:textColor="@color/black"
                android:textSize="@dimen/tittle_text_size"
                app:icon="@drawable/magnifier"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingHorizontal="@dimen/settings_horizontal_padding"
                    android:text="@string/dark_mode"
                    android:textColor="@color/black"
                    android:textSize="@dimen/bottom_text_size" />

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:checked="true"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingHorizontal="@dimen/settings_horizontal_padding"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingHorizontal="@dimen/settings_horizontal_padding"
                    android:text="@string/share_app"
                    android:textColor="@color/black"
                    android:textSize="@dimen/bottom_text_size" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingStart="@dimen/settings_bottom_start_padding"
                    android:paddingEnd="@dimen/settings_bottom_end_padding"
                    app:icon="@drawable/share_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingHorizontal="16dp"
                    android:text="@string/write_support"
                    android:textColor="@color/black"
                    android:textSize="@dimen/bottom_text_size" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:outlineSpotShadowColor="@color/white"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingStart="@dimen/settings_bottom_start_padding"
                    android:paddingEnd="@dimen/settings_bottom_end_padding"
                    app:icon="@drawable/support_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingHorizontal="@dimen/settings_horizontal_padding"
                    android:text="@string/agreement"
                    android:textColor="@color/black"
                    android:textSize="@dimen/bottom_text_size" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:outlineSpotShadowColor="@color/white"
                    android:paddingVertical="@dimen/settings_vertical_padding"
                    android:paddingStart="@dimen/settings_bottom_start_padding"
                    android:paddingEnd="@dimen/settings_bottom_end_padding"
                    app:icon="@drawable/arrow_forward_simple_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
