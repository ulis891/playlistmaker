<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:outlineSpotShadowColor="@color/white"
                app:icon="@drawable/arrow_back_icon"
                app:iconTint="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:fontFamily="@font/yandex_sans_text_medium"
                android:textColor="@color/black"
                android:textSize="22sp"
                app:icon="@drawable/magnifier"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="21dp"
                    android:paddingLeft="16dp"
                    android:text="Темная тема"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:checked="true"
                    android:paddingVertical="21dp"
                    android:paddingRight="16dp"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="21dp"
                    android:paddingLeft="16dp"
                    android:text="Поделиться приложением"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:outlineSpotShadowColor="@color/white"
                    android:paddingTop="19dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="18dp"
                    app:icon="@drawable/share_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="21dp"
                    android:paddingLeft="16dp"
                    android:text="Написать в поддержку"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:outlineSpotShadowColor="@color/white"
                    android:paddingTop="19dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="18dp"
                    app:icon="@drawable/support_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/yandex_sans_display_regular"
                    android:paddingVertical="21dp"
                    android:paddingLeft="16dp"
                    android:text="Пользовательское соглашение"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:outlineSpotShadowColor="@color/white"
                    android:paddingTop="19dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="18dp"
                    app:icon="@drawable/arrow_forward_simpl_icon"
                    app:iconTint="@color/gray" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
