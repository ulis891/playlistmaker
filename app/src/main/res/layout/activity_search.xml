<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity"
    android:background="@color/regular_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                style="@style/SettingsBackIconStyle"
                android:id="@+id/back_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/back_arrow_margin"
                android:layout_marginStart="@dimen/back_arrow_margin"
                android:layout_marginEnd="@dimen/zero"
                android:contentDescription="@string/go_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back_24" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/zero"
                android:layout_marginVertical="4dp"
                android:paddingBottom="12dp"
                android:paddingTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/zero"
                android:text="@string/search"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/text_color"
                android:textSize="@dimen/tittle_text_size"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/search_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                android:maxLines="1"
                android:focusable="true"
                android:autofillHints=""
                app:cornerRadius="16dp"
                android:background="@drawable/rounded_edit_text"
                android:inputType="text"
                android:drawableStart="@drawable/ic_search_icon_16"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_hint"
                android:hint="@string/search"
                android:fontFamily="@font/yandex_sans_display_regular"
                android:textSize="16sp"
                android:textColor="@color/text_input_color"
                android:textColorHint="@color/text_hint"
                android:imeOptions="actionDone"
                android:singleLine="true"
                />

            <ImageButton
                android:id="@+id/button_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="28dp"
                android:background="@color/text_input_background"
                app:tint="@color/text_hint"
                android:contentDescription="@string/clean_text_edit"
                android:src="@drawable/ic_clear_16"
                android:visibility="gone" />
            </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/view_track" />
        <ImageView
            android:id="@+id/nothing_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="102dp"
            android:contentDescription="@string/nothing_result_placeholder"
            android:src="@drawable/ic_light_mode_nothing_result_placeholder_120"
            android:visibility="gone"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="238dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/nothing_result_placeholder"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/text_color"
                android:textSize="19sp"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>